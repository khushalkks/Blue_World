theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "[b][color=#00e5ff]CONTROLS:[/color][/b]
• [b]Move Left / Right:[/b] [b]A / D[/b] or [b]Arrow Keys[/b]
• [b]Jump:[/b] [b]SPACEBAR[/b], [b]W[/b], or [b]Up Arrow[/b] (hold longer for higher jump!)
• [b]Pause / Menu:[/b] [b]ESC[/b]

[b][color=#50fa7b]EXCITING MECHANICS:[/color][/b]
• [b]Stomp on Enemies:[/b] Jump right on top of Goombas & flying bats to crush them and bounce higher!
• [b]Hit [?] Blocks:[/b] Jump and hit golden question blocks with your head from underneath to collect coins!
• [b]Spring Pads:[/b] Step on springs to launch super high into the clouds!
• [b]Collect Coins:[/b] Every 100 coins gives you an extra life!
• [b]Defeat King Boss in World 1-3:[/b] Land 3 stomps on his head to claim ultimate victory!"

