[node name="Clue1_Terminal" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(-320, -180)
clue_id = "terminal"
clue_title = "VANCE'S AUDIO LOG // LOG #084"
clue_content = "[color=#00e5ff][b]DR. ARIS VANCE (AUDIO RECORDING):[/b][/color]\n\n\"Ellis! If you made it inside Sector A, listen carefully: I scrambled the emergency blast door override code so the facility security drones couldn't track me down.\n\nThe 4-digit code starts with our location:\n• [color=#ffdd44][b]DIGIT 1:[/b][/color] Look at the room identification plaque on the north bulkhead. This entire lab wing is [b]SECTOR 7[/b].\n\n[color=#e0e8ff]Vance's voice strains:[/color] \"Find my cryo report and the oscilloscope to get the remaining digits!\""
prompt_text = "[E] Inspect Vance's Terminal"
custom_glow_color = Color(0, 0.9, 1, 1)

[node name="Clue2_Whiteboard" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(320, -180)
clue_id = "whiteboard"
clue_title = "CRYO-RESONANCE WHITEBOARD"
clue_content = "[color=#00e5ff][b]SPECIMEN OMEGA CRYOGENIC ANALYSIS:[/b][/color]\n\nAnomalous bio-acoustic organism isolated at -180°C.\n\n• [color=#ffdd44][b]DIGIT 2 (Cryo-Stabilizer Frequency):[/b][/color] Calibrated at index [b]3[/b].\n• [color=#ffdd44][b]DIGIT 3 (Harmonic Resonance Peak):[/b][/color] Spikes at channel [b]9[/b].\n\n[color=#ff79c6]Vance's handwritten red ink note:[/color]\n\"The door lock's middle digits are always the Stabilizer ([b]3[/b]) followed immediately by the Peak ([b]9[/b]).\""
prompt_text = "[E] Inspect Specimen Board"
custom_texture = ExtResource("7_whiteboard_tex")
custom_glow_color = Color(0.95, 0.35, 1, 1)

[node name="Clue3_AudioConsole" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(-320, 160)
clue_id = "bio_shelf"
clue_title = "TELEMETRY OSCILLOSCOPE CONSOLE"
clue_content = "[color=#00e5ff][b]SUB-LEVEL 4 FREQUENCY SWEEP READOUT:[/b][/color]\n\nAutomated scanner cycling through subterranean emergency channels:\n• Channel 1: Overloaded static (Offline)\n• Channel 2: Carrier wave severed\n• Channel 3: Atmospheric interference\n• [color=#50fa7b][b]Channel 4: TRANSMISSION ACTIVE (Dr. Vance's Sub-Level 4 Transceiver)[/b][/color]\n\n[color=#ffb86c]Facility Safety Standard Protocol:[/color]\n\"The final digit of all security doors is keyed to the active telemetry receiver channel ([b]4[/b]).\""
prompt_text = "[E] Inspect Audio Console"
custom_texture = ExtResource("8_bio_tex")
custom_glow_color = Color(0.1, 1, 0.5, 1)

