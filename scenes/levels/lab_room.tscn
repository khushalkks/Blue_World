[node name="Clue1_Terminal" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(-320, -180)
clue_id = "terminal"
clue_title = "SECURITY TERMINAL // INCIDENT LOG #07"
clue_content = "[color=#00e5ff][b]CRYO-CONTAINMENT SECURITY LOG // STATION 1[/b][/color]\n[color=#3d5a80]═════════════════════════════════════════════════[/color]\n[color=#ff5555][b]ALERT: SPECIMEN OUTBREAK IN SUB-LEVEL SECTOR[/b][/color]\n\n[color=#e0e8ff]At 02:40 AM, an unknown bio-electric entity ruptured its stasis chamber. Dr. Vance sealed the north blast door with a 4-digit code across the room's 3 stations.[/color]\n\n[color=#00e5ff][b]DIAGNOSTIC STATUS OF CRYO-PODS (1 TO 10):[/b][/color]\n  • Pods 1 through 6: [color=#50fa7b][ INTACT - PODS SEALED ][/color]\n  • [color=#ff4444][b]Pod 7: [!! BREACHED - SPECIMEN ESCAPED !!][/b][/color]\n  • Pods 8 through 10: [color=#708090][ EMPTY / STANDBY ][/color]\n\n[color=#ffdd44][b]◆ CLUE FOR DIGIT 1 (The Breached Pod):[/b][/color]\n[color=#e0e8ff]Security Protocol locks the first digit to the ruptured pod number.[/color]\n[color=#50fa7b][b]>>> FIRST CODE DIGIT IS: 7 <<<[/b][/color]"
prompt_text = "[E] Inspect Security Terminal (Clue 1)"
custom_glow_color = Color(0, 0.9, 1, 1)

[node name="Clue2_Whiteboard" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(320, -180)
clue_id = "whiteboard"
clue_title = "RESEARCH BOARD // TRANQUILIZER RECIPE"
clue_content = "[color=#ff79c6][b]SPECIMEN SUBJUGATION FORMULA // STATION 2[/b][/color]\n[color=#3d5a80]═════════════════════════════════════════════════[/color]\n[color=#e0e8ff]A research chalkboard pinned with schematics, chemical diagrams, and urgent yellow sticky notes left by Dr. Vance:[/color]\n\n[color=#ffdd44]\"If Specimen 7 attacks, mix the neuro-sedative compound immediately to pacify it! DO NOT mess up the ratio:\"[/color]\n\n[color=#00e5ff][b]SEDATIVE CHEMICAL RATIO (MIDDLE DIGITS):[/b][/color]\n  • [color=#50fa7b][b]Step 1 (Digit 2):[/b][/color] Exactly [color=#ffdd44][b]3[/b][/color] vials of Blue Stabilizer.\n  • [color=#50fa7b][b]Step 2 (Digit 3):[/b][/color] Exactly [color=#ffdd44][b]9[/b][/color] grams of Golden Catalyst.\n\n[color=#ffb86c][b]◆ CLUE FOR DIGITS 2 & 3 (The Chemical Ratio):[/b][/color]\n[color=#e0e8ff]The blast door override requires the sedative formula in sequence.[/color]\n[color=#50fa7b][b]>>> MIDDLE CODE DIGITS ARE: 3 then 9 <<<[/b][/color]"
prompt_text = "[E] Inspect Research Board (Clue 2)"
custom_texture = ExtResource("7_whiteboard_tex")
custom_glow_color = Color(0.95, 0.35, 1, 1)

[node name="Clue3_AudioConsole" parent="." instance=ExtResource("6_clue_scene")]
position = Vector2(-320, 160)
clue_id = "bio_shelf"
clue_title = "RADIO OSCILLOSCOPE // RESCUE SCANNER"
clue_content = "[color=#50fa7b][b]EMERGENCY FREQUENCY MONITOR // STATION 3[/b][/color]\n[color=#3d5a80]═════════════════════════════════════════════════[/color]\n[color=#e0e8ff]A glowing phosphor oscilloscope receiver actively scanning shortwave radio channels from the underground abyss:[/color]\n\n  • Channel 1: [color=#708090][ DEAD CARRIER - NO SIGNAL ][/color]\n  • Channel 2: [color=#708090][ DRONE JAMMING STATIC ][/color]\n  • Channel 3: [color=#708090][ REACTOR HUM INTERFERENCE ][/color]\n  • [color=#50fa7b][b]Channel 4: [◄ LIVE DISTRESS TRANSMISSION DETECTED! ►][/b][/color]\n\n[color=#00e5ff]Dr. Vance's voice crackles over the radio speaker:[/color]\n\"Ellis! The blast door final digit is synced to my broadcast channel! Tune to channel 4 to escape!\"\n\n[color=#ffdd44][b]◆ CLUE FOR DIGIT 4 (The Active Frequency):[/b][/color]\n[color=#e0e8ff]The only transmitting rescue beacon is broadcasting on channel 4.[/color]\n[color=#50fa7b][b]>>> FINAL CODE DIGIT IS: 4 <<<[/b][/color]"
prompt_text = "[E] Inspect Radio Console (Clue 3)"
custom_texture = ExtResource("8_bio_tex")
custom_glow_color = Color(0.1, 1, 0.5, 1)

